            "url": {
              "raw": "{{soutenance_url}}/api/documents/upload",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "documents", "upload"]
            },
            "description": "CDC: Rapport anti-plagiat (document obligatoire)"
          }
        },
        {
          "name": "Étape 5 - Upload rapport publications (CDC)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "soutenanceId",
                  "value": "{{soutenanceId}}",
                  "type": "text"
