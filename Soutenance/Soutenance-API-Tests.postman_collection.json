      "item": [
        {
          "name": "Upload document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "soutenanceId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "typeDocument",
                  "value": "RAPPORT_THESE",
                  "type": "text"
                },
                {
                  "key": "fichier",
                  "type": "file",
                  "src": "/path/to/document.pdf"
                },
                {
                  "key": "depotPar",
                  "value": "Jean Dupont",
                  "type": "text"
                }
              ]
            },
            "url": {
