            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorantId\": 1,\n  \"doctorantNom\": \"Jean Dupont\",\n  \"doctorantEmail\": \"jean.dupont@example.com\",\n  \"directeurId\": 2,\n  \"directeurNom\": \"Prof. Martin\"\n}"
            },
            "url": {
              "raw": "http://localhost:8084/api/soutenances/demande",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8084",
              "path": ["api", "soutenances", "demande"]
