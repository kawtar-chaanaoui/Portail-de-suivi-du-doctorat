{
  "info": {
    "name": "CDC - Tests Soutenance & Notification",
    "description": "Tests basés sur le cahier des charges - Module 3 (Soutenance) et Module 4 (Notification)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "soutenance_url",
      "value": "http://localhost:8084"
    },
    {
      "key": "notification_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "soutenanceId",
      "value": ""
    },
    {
      "key": "juryId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "doctorantEmail",
      "value": "jean.dupont@doctorant.ma"
    },
    {
      "key": "directeurEmail",
      "value": "prof.martin@univ.ma"
    }
  ],
  "item": [
    {
      "name": "SCENARIO COMPLET CDC - Processus de Soutenance avec Notifications",
      "description": "Workflow complet conforme au cahier des charges",
      "item": [
        {
          "name": "Étape 1 - Demande de soutenance par le doctorant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC: Le doctorant soumet sa demande de soutenance",
                  "pm.test(\"[CDC] Demande créée avec succès\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"[CDC] ID soutenance généré\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set('soutenanceId', jsonData.id);",
                  "    console.log('✅ Soutenance créée - ID: ' + jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"[CDC] Statut initial EN_ATTENTE\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.statut).to.equal('EN_ATTENTE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorantId\": 1,\n  \"doctorantNom\": \"Jean DUPONT\",\n  \"doctorantEmail\": \"{{doctorantEmail}}\",\n  \"directeurId\": 2,\n  \"directeurNom\": \"Prof. Ahmed MARTIN\",\n  \"directeurEmail\": \"{{directeurEmail}}\",\n  \"titreThese\": \"Intelligence Artificielle appliquée au diagnostic médical\",\n  \"specialite\": \"Informatique\",\n  \"laboratoire\": \"LISI\",\n  \"etablissement\": \"ENSIAS\"\n}"
            },
            "url": {
              "raw": "{{soutenance_url}}/api/soutenances/demande",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "soutenances", "demande"]
            }
          }
        },
        {
          "name": "Étape 2 - Notification envoyée au doctorant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC Module 4: Notification automatique",
                  "pm.test(\"[CDC] Notification programmée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.exist;",
                  "    console.log('✅ Notification envoyée: Demande de soutenance reçue');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"{{doctorantEmail}}\",\n  \"studentName\": \"Jean DUPONT\",\n  \"subject\": \"Demande de soutenance enregistrée\",\n  \"body\": \"Votre demande de soutenance a été enregistrée avec succès. Elle est en attente de vérification des prérequis.\",\n  \"templateCode\": \"DEMANDE_SOUTENANCE_RECUE\"\n}"
            },
            "url": {
              "raw": "{{notification_url}}/api/notifications/send-email",
              "host": ["{{notification_url}}"],
              "path": ["api", "notifications", "send-email"]
            }
          }
        },
        {
          "name": "Étape 3 - Upload documents obligatoires (CDC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC: Documents obligatoires à fournir",
                  "pm.test(\"[CDC] Document uploadé\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('documentId', jsonData.id);",
                  "        console.log('✅ Document uploadé - ID: ' + jsonData.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "soutenanceId",
                  "value": "{{soutenanceId}}",
                  "type": "text",
                  "description": "ID de la soutenance"
                },
                {
                  "key": "typeDocument",
                  "value": "RAPPORT_THESE",
                  "type": "text",
                  "description": "CDC: Rapport de thèse obligatoire"
                },
                {
                  "key": "fichier",
                  "type": "file",
                  "src": "",
                  "description": "Fichier PDF du rapport"
                },
                {
                  "key": "depotPar",
                  "value": "Jean DUPONT",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{soutenance_url}}/api/documents/upload",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "documents", "upload"]
            },
            "description": "CDC: Upload du rapport de thèse (document obligatoire)"
          }
        },
        {
          "name": "Étape 4 - Upload rapport anti-plagiat (CDC)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "soutenanceId",
                  "value": "{{soutenanceId}}",
                  "type": "text"
                },
                {
                  "key": "typeDocument",
                  "value": "RAPPORT_ANTIPLAGIAT",
                  "type": "text",
