                }
              ]
            },
            "url": {
              "raw": "{{soutenance_url}}/api/documents/upload",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "documents", "upload"]
            }
          }
        },
        {
          "name": "Étape 6 - Upload attestations formations (CDC)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "soutenanceId",
                  "value": "{{soutenanceId}}",
                  "type": "text"
                },
                {
                  "key": "typeDocument",
                  "value": "ATTESTATIONS_FORMATIONS",
                  "type": "text",
                  "description": "CDC: Attestations formations (200h requises)"
                },
                {
                  "key": "fichier",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "depotPar",
                  "value": "Jean DUPONT",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{soutenance_url}}/api/documents/upload",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "documents", "upload"]
            }
          }
        },
        {
          "name": "Étape 7 - Validation des documents par l'admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Document validé\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Document validé par l\\'administration');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/documents/{{documentId}}/valider?valide=true&commentaire=Document conforme aux exigences",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "documents", "{{documentId}}", "valider"],
              "query": [
                {
                  "key": "valide",
                  "value": "true"
                },
                {
                  "key": "commentaire",
                  "value": "Document conforme aux exigences"
                }
              ]
            },
            "description": "CDC: Validation administrative des documents"
          }
        },
        {
          "name": "Étape 8 - Vérification prérequis soutenance (CDC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC: Prérequis obligatoires",
                  "// - Au moins 2 articles journaux (Q1/Q2)",
                  "// - Au moins 2 conférences",
                  "// - 200h de formation",
                  "pm.test(\"[CDC] Vérification prérequis effectuée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Vérification des prérequis CDC lancée');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/soutenances/{{soutenanceId}}/verifier-prerequis",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}", "verifier-prerequis"]
            },
            "description": "CDC: Check-list prérequis (publications, formations, documents)"
          }
        },
        {
          "name": "Étape 9 - Consulter prérequis validés",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Prérequis consultables\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    console.log('📋 Prérequis:', JSON.stringify(jsonData, null, 2));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/prerequis/soutenance/{{soutenanceId}}",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "prerequis", "soutenance", "{{soutenanceId}}"]
            }
          }
        },
        {
          "name": "Étape 10 - Proposition jury par Directeur (CDC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC: Proposition du jury par le Directeur de Thèse",
                  "pm.test(\"[CDC] Jury proposé\", function() {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('juryId', jsonData.id);",
                  "        console.log('✅ Jury proposé - ID: ' + jsonData.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"soutenanceId\": {{soutenanceId}},\n  \"directeurTheseId\": 2,\n  \"directeurNom\": \"Prof. Ahmed MARTIN\",\n  \"membres\": [\n    {\n      \"nomComplet\": \"Prof. Mohammed ALAMI\",\n      \"email\": \"m.alami@univ.ma\",\n      \"institution\": \"Université Mohammed V - Rabat\",\n      \"grade\": \"Professeur\",\n      \"role\": \"PRESIDENT\"\n    },\n    {\n      \"nomComplet\": \"Prof. Fatima BENNANI\",\n      \"email\": \"f.bennani@univ.ma\",\n      \"institution\": \"Université Hassan II - Casablanca\",\n      \"grade\": \"Professeur\",\n      \"role\": \"RAPPORTEUR\"\n    },\n    {\n      \"nomComplet\": \"Dr. Karim IDRISSI\",\n      \"email\": \"k.idrissi@univ.ma\",\n      \"institution\": \"ENSIAS\",\n      \"grade\": \"Maitre de conferences\",\n      \"role\": \"RAPPORTEUR\"\n    },\n    {\n      \"nomComplet\": \"Dr. Amina TAHIRI\",\n      \"email\": \"a.tahiri@univ.ma\",\n      \"institution\": \"ENSIAS\",\n      \"grade\": \"Maitre de conferences\",\n      \"role\": \"EXAMINATEUR\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{soutenance_url}}/api/jurys/proposer",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "jurys", "proposer"]
            },
            "description": "CDC: Le directeur de thèse propose les membres du jury (rapporteurs, examinateurs, président)"
          }
        },
        {
          "name": "Étape 11 - Notification proposition jury",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"{{directeurEmail}}\",\n  \"studentName\": \"Jean DUPONT\",\n  \"subject\": \"Composition du jury proposée\",\n  \"body\": \"La composition du jury pour la soutenance a été enregistrée. En attente de validation administrative.\",\n  \"variables\": {\n    \"juryMembers\": \"Prof. ALAMI, Prof. BENNANI, Dr. IDRISSI, Dr. TAHIRI\"\n  }\n}"
            },
            "url": {
              "raw": "{{notification_url}}/api/notifications/reunion-jury",
              "host": ["{{notification_url}}"],
              "path": ["api", "notifications", "reunion-jury"]
            },
            "description": "CDC Module 4: Notification automatique"
          }
        },
        {
          "name": "Étape 12 - Validation jury par administration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Jury validé par administration\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Jury validé par l\\'administration');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/jurys/{{juryId}}/valider",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "jurys", "{{juryId}}", "valider"]
            },
            "description": "CDC: Validation administrative du jury proposé"
          }
        },
        {
          "name": "Étape 13 - Génération autorisation soutenance (CDC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC Module 4: Génération document PDF",
                  "pm.test(\"[CDC] Autorisation générée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Autorisation de soutenance générée (PDF)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorantNom\": \"Jean DUPONT\",\n  \"titreThese\": \"Intelligence Artificielle appliquée au diagnostic médical\",\n  \"dateSoutenance\": \"2026-06-15\",\n  \"lieuSoutenance\": \"ENSIAS - Amphithéâtre A\"\n}"
            },
            "url": {
              "raw": "{{notification_url}}/api/documents/autorisation-soutenance",
              "host": ["{{notification_url}}"],
              "path": ["api", "documents", "autorisation-soutenance"]
            },
            "description": "CDC Module 4: Génération du PDF d'autorisation de soutenance"
          }
        },
        {
          "name": "Étape 14 - Notification autorisation accordée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"{{doctorantEmail}}\",\n  \"studentName\": \"Jean DUPONT\",\n  \"subject\": \"Autorisation de soutenance accordée\",\n  \"body\": \"Félicitations ! Votre autorisation de soutenance a été accordée. Vous recevrez prochainement la date et le lieu.\"\n}"
            },
            "url": {
              "raw": "{{notification_url}}/api/notifications/soutenance-autorisee",
              "host": ["{{notification_url}}"],
              "path": ["api", "notifications", "soutenance-autorisee"]
            },
            "description": "CDC: Notification automatique d'autorisation"
          }
        },
        {
          "name": "Étape 15 - Planification soutenance (CDC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC: Planification administrative",
                  "pm.test(\"[CDC] Soutenance planifiée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Date, heure et lieu fixés par l\\'administration');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/soutenances/{{soutenanceId}}/planifier?date=2026-06-15T14:00:00&lieu=ENSIAS&salle=Amphitheatre A",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}", "planifier"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-06-15T14:00:00"
                },
                {
                  "key": "lieu",
                  "value": "ENSIAS"
                },
                {
                  "key": "salle",
                  "value": "Amphitheatre A"
                }
              ]
            },
            "description": "CDC: L'administration fixe et communique la date, heure et lieu"
          }
        },
        {
          "name": "Étape 16 - Notification soutenance planifiée",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Notification planification envoyée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    console.log('✅ Notification envoyée: Date et lieu communiqués');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"{{doctorantEmail}}\",\n  \"studentName\": \"Jean DUPONT\",\n  \"subject\": \"Date de soutenance confirmée\",\n  \"body\": \"Votre soutenance est fixée au 15 juin 2026 à 14h00 à l'Amphithéâtre A de l'ENSIAS.\",\n  \"variables\": {\n    \"defenseDate\": \"15 juin 2026 à 14h00\",\n    \"defenseLocation\": \"ENSIAS - Amphithéâtre A\"\n  }\n}"
            },
            "url": {
              "raw": "{{notification_url}}/api/notifications/soutenance-planifiee",
              "host": ["{{notification_url}}"],
              "path": ["api", "notifications", "soutenance-planifiee"]
            },
            "description": "CDC Module 4: Communication de la date/lieu"
          }
        },
        {
          "name": "Étape 17 - Consulter état final soutenance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Soutenance PLANIFIEE\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.statut).to.equal('PLANIFIEE');",
                  "    console.log('📊 État final:', jsonData.statut);",
                  "    console.log('📅 Date:', jsonData.dateSoutenance);",
                  "    console.log('📍 Lieu:', jsonData.lieuSoutenance);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/soutenances/{{soutenanceId}}",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}"]
            }
          }
        },
        {
          "name": "Étape 18 - Vérifier historique notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// CDC Module 4: Traçabilité des notifications",
                  "pm.test(\"[CDC] Historique notifications disponible\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    console.log('📧 Nombre de notifications:', jsonData.length);",
                  "    jsonData.forEach(function(notif, index) {",
                  "        console.log((index+1) + '. ' + notif.subject + ' - ' + notif.status);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notification_url}}/api/notifications?email={{doctorantEmail}}",
              "host": ["{{notification_url}}"],
              "path": ["api", "notifications"],
              "query": [
                {
                  "key": "email",
                  "value": "{{doctorantEmail}}"
                }
              ]
            },
            "description": "Vérification de toutes les notifications envoyées au doctorant"
          }
        },
        {
          "name": "Étape 19 - Terminer soutenance avec résultat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[CDC] Soutenance terminée\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.statut).to.equal('TERMINEE');",
                  "    console.log('✅ Soutenance terminée - Résultat:', jsonData.resultat);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_url}}/api/soutenances/{{soutenanceId}}/terminer?resultat=ADMIS&mention=TRES_HONORABLE",
              "host": ["{{soutenance_url}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}", "terminer"],
              "query": [
                {
                  "key": "resultat",
                  "value": "ADMIS"
                },
                {
                  "key": "mention",
                  "value": "TRES_HONORABLE"
                }
              ]
            }
          }
        },
