{
  "info": {
    "name": "Soutenance & Notification - Tests Complets",
    "description": "Tests indépendants et d'intégration pour Soutenance et Notification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "soutenance-notification-tests"
  },
  "variable": [
    {
      "key": "soutenance_host",
      "value": "http://localhost:8084"
    },
    {
      "key": "notification_host",
      "value": "http://localhost:8081"
    },
    {
      "key": "gateway_host",
      "value": "http://localhost:8888"
    },
    {
      "key": "soutenanceId",
      "value": ""
    },
    {
      "key": "juryId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "doctorantEmail",
      "value": "jean.dupont@example.com"
    }
  ],
  "item": [
    {
      "name": "SCENARIO COMPLET - Intégration Soutenance + Notification",
      "description": "Workflow complet de A à Z avec vérification des notifications",
      "item": [
        {
          "name": "1. Créer demande soutenance (→ Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Récupération soutenanceId\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set('soutenanceId', jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorantId\": 1,\n  \"doctorantNom\": \"Jean Dupont\",\n  \"doctorantEmail\": \"{{doctorantEmail}}\",\n  \"directeurId\": 2,\n  \"directeurNom\": \"Prof. Martin\",\n  \"directeurEmail\": \"prof.martin@univ.fr\",\n  \"titreThese\": \"Intelligence Artificielle pour la médecine\",\n  \"specialite\": \"Informatique\"\n}"
            },
            "url": {
              "raw": "{{soutenance_host}}/api/soutenances/demande",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "soutenances", "demande"]
            }
          }
        },
        {
          "name": "2. Vérifier notification demande créée",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Notifications reçues\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set('notificationId', jsonData[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notification_host}}/api/notifications?email={{doctorantEmail}}",
              "host": ["{{notification_host}}"],
              "path": ["api", "notifications"],
              "query": [{"key": "email", "value": "{{doctorantEmail}}"}]
            }
          }
        },
        {
          "name": "3. Upload document thèse (→ Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Document uploadé\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('documentId', jsonData.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "soutenanceId", "value": "{{soutenanceId}}", "type": "text"},
                {"key": "typeDocument", "value": "RAPPORT_THESE", "type": "text"},
                {"key": "fichier", "type": "file", "src": ""},
                {"key": "depotPar", "value": "Jean Dupont", "type": "text"}
              ]
            },
            "url": {
              "raw": "{{soutenance_host}}/api/documents/upload",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "documents", "upload"]
            }
          }
        },
        {
          "name": "4. Valider document (→ Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Document validé\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_host}}/api/documents/{{documentId}}/valider?valide=true&commentaire=Document conforme",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "documents", "{{documentId}}", "valider"],
              "query": [
                {"key": "valide", "value": "true"},
                {"key": "commentaire", "value": "Document conforme"}
              ]
            }
          }
        },
        {
          "name": "5. Vérifier prérequis (→ Notification)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_host}}/api/soutenances/{{soutenanceId}}/verifier-prerequis",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}", "verifier-prerequis"]
            }
          }
        },
        {
          "name": "6. Proposer jury (→ Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Jury proposé\", function() {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('juryId', jsonData.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"soutenanceId\": {{soutenanceId}},\n  \"directeurTheseId\": 2,\n  \"directeurNom\": \"Prof. Martin\",\n  \"membres\": [\n    {\n      \"nomComplet\": \"Dr. Pierre Durant\",\n      \"email\": \"pierre.durant@univ.fr\",\n      \"institution\": \"Université Paris\",\n      \"grade\": \"Professeur\",\n      \"role\": \"PRESIDENT\"\n    },\n    {\n      \"nomComplet\": \"Dr. Marie Leblanc\",\n      \"email\": \"marie.leblanc@univ.fr\",\n      \"institution\": \"Université Lyon\",\n      \"grade\": \"Maitre de conferences\",\n      \"role\": \"RAPPORTEUR\"\n    },\n    {\n      \"nomComplet\": \"Dr. Jean Bernard\",\n      \"email\": \"jean.bernard@univ.fr\",\n      \"institution\": \"Université Bordeaux\",\n      \"grade\": \"Professeur\",\n      \"role\": \"RAPPORTEUR\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{soutenance_host}}/api/jurys/proposer",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "jurys", "proposer"]
            }
          }
        },
        {
          "name": "7. Valider jury (→ Notification)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_host}}/api/jurys/{{juryId}}/valider",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "jurys", "{{juryId}}", "valider"]
            }
          }
        },
        {
          "name": "8. Planifier soutenance (→ Notification)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{soutenance_host}}/api/soutenances/{{soutenanceId}}/planifier?date=2026-06-15T14:00:00&lieu=Amphitheatre A&salle=Salle 101",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}", "planifier"],
              "query": [
                {"key": "date", "value": "2026-06-15T14:00:00"},
                {"key": "lieu", "value": "Amphitheatre A"},
                {"key": "salle", "value": "Salle 101"}
              ]
            }
          }
        },
        {
          "name": "9. Vérifier toutes les notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Plusieurs notifications reçues\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    console.log('Nombre de notifications:', jsonData.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notification_host}}/api/notifications?email={{doctorantEmail}}",
              "host": ["{{notification_host}}"],
              "path": ["api", "notifications"],
              "query": [{"key": "email", "value": "{{doctorantEmail}}"}]
            }
          }
        },
        {
          "name": "10. État final de la soutenance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Soutenance PLANIFIEE\", function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.statut).to.equal('PLANIFIEE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{soutenance_host}}/api/soutenances/{{soutenanceId}}",
              "host": ["{{soutenance_host}}"],
              "path": ["api", "soutenances", "{{soutenanceId}}"]
            }
          }
        }
      ]
    },
